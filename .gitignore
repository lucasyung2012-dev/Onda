# Configurações locais do editor/assistente (não fazem parte do app)
.claude/

# Arquivo bruto das notícias de hoje: o robô gera e usa na hora; não precisa ir para o repositório
data/noticias/hoje.json

# Chave privada dos avisos (vai só para os Secrets do GitHub; nunca no repositório)
.vapid-privada.txt

# Arquivos que mudam a cada coleta: moram no ramo "dados" (ver .github/dados.sh),
# para o histórico da main não crescer ~2,8 GB por ano.
data/noticias/
data/app/hoje.json
data/app/indicadores.json
data/relatorio-coleta.json

# Destaque e tema de hoje para o app: montados a partir do arquivo do dia
# (data/analises, data/temas), para não ficarem duplicados no repositório.
data/app/analise.json
data/app/analise-en.json
data/app/tema.json
data/app/tema-en.json

# Pasta montada na publicação do site (coletor/site.mjs)
_site/
